<!-- pages/chat/chat.wxml - 港房通AI对话页面 -->
<view class="container">
  <!-- 消息列表 -->
  <scroll-view 
    class="message-list" 
    scroll-y="true" 
    scroll-into-view="{{scrollToMessage}}"
    enhanced="true"
    show-scrollbar="true"
  >
    <!-- 欢迎消息 -->
    <view class="message-item system-message" id="msg-welcome">
      <view class="message-content">
        <text class="message-text">👋 欢迎使用港房通AI助手！

我可以帮您：
• 查询香港各屋苑的租售比、价格趋势
• 分析房产投资价值
• 对比不同区域/屋苑
• 解答香港房产相关问题

请直接输入您的问题，例如：
「太古城的租售比是多少？」
「港岛区有哪些高租售比的屋苑？」</text>
      </view>
    </view>

    <!-- 消息列表 -->
    <block wx:for="{{messages}}" wx:key="id">
      <!-- 用户消息 -->
      <view class="message-item user-message" id="msg-{{item.id}}" wx:if="{{item.role === 'user'}}">
        <view class="message-content">
          <text class="message-text">{{item.content}}</text>
        </view>
      </view>

      <!-- AI消息 -->
      <view class="message-item ai-message" id="msg-{{item.id}}" wx:if="{{item.role === 'assistant'}}">
        <view class="avatar">
          <text class="avatar-text">AI</text>
        </view>
        <view class="message-content">
          <!-- 使用rich-text渲染markdown -->
          <rich-text class="message-text markdown-body" nodes="{{item.renderedContent}}"></rich-text>
          
          <!-- 工具调用信息 -->
          <view class="tools-info" wx:if="{{item.toolsUsed && item.toolsUsed.length > 0}}">
            <text class="tools-text">使用了: {{item.toolsUsed.join('、')}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 加载中状态 -->
    <view class="message-item ai-message loading" wx:if="{{isLoading}}">
      <view class="avatar">
        <text class="avatar-text">AI</text>
      </view>
      <view class="message-content">
        <view class="loading-dots">
          <text class="dot">.</text>
          <text class="dot">.</text>
          <text class="dot">.</text>
        </view>
        <text class="status-text" wx:if="{{statusText}}">{{statusText}}</text>
      </view>
    </view>

    <!-- 底部占位 -->
    <view id="msg-bottom" style="height: 20rpx;"></view>
  </scroll-view>

  <!-- 输入区域 -->
  <view class="input-area">
    <view class="input-wrapper">
      <input 
        class="message-input"
        type="text"
        placeholder="请输入您的问题..."
        value="{{inputValue}}"
        bindinput="onInputChange"
        bindconfirm="sendMessage"
        confirm-type="send"
        disabled="{{isLoading}}"
      />
      <button 
        class="send-btn {{inputValue.trim() ? 'active' : ''}}" 
        bindtap="sendMessage"
        disabled="{{!inputValue.trim() || isLoading}}"
      >
        <text class="send-icon">发送</text>
      </button>
    </view>
    <text class="input-hint">AI生成内容仅供参考，投资需谨慎</text>
  </view>
</view>
