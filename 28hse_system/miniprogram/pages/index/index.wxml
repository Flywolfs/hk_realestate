<!-- pages/index/index.wxml - 首页地图 -->
<view class="container">
  <!-- 截图水印层 -->
  <view class="watermark-layer" wx:if="{{!loading}}">
    <view class="watermark-text" wx:for="{{watermarkList}}" wx:key="index" style="left: {{item.x}}rpx; top: {{item.y}}rpx; transform: rotate({{item.rotate}}deg);">
      {{item.text}}
    </view>
  </view>

  <!-- 地图容器 -->
  <map 
    id="estate-map"
    class="map"
    latitude="{{centerLat}}"
    longitude="{{centerLng}}"
    scale="{{scale}}"
    markers="{{markers}}"
    show-location="{{true}}"
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
    enable-3D="{{false}}"
    enable-overlooking="{{false}}"
    enable-zoom="{{true}}"
    enable-scroll="{{true}}"
    enable-rotate="{{false}}"
    show-compass="{{false}}"
  >
    <!-- 地图控件 -->
    <cover-view class="map-controls">
      <cover-view class="control-btn search-btn" bindtap="showSearch">
        <cover-view class="btn-text">搜索</cover-view>
      </cover-view>
      <cover-view class="control-btn filter-btn {{hasActiveFilter ? 'active' : ''}}" bindtap="toggleFilterPanel">
        <cover-view class="btn-text">筛选</cover-view>
        <cover-view class="filter-badge" wx:if="{{hasActiveFilter}}"></cover-view>
      </cover-view>
      <cover-view class="control-btn legend-btn" bindtap="toggleLegend">
        <cover-view class="btn-text">图例</cover-view>
      </cover-view>
      <cover-view class="control-btn locate-btn" bindtap="relocate">
        <cover-view class="btn-text">重置</cover-view>
      </cover-view>
    </cover-view>
    
    <!-- 房屋类型筛选按钮 -->
    <cover-view class="housing-filter-container">
      <cover-view class="housing-filter-btn {{housingTypeFilter.showPublic ? 'active' : ''}}" bindtap="togglePublic">
        <cover-view class="filter-dot public-dot"></cover-view>
        <cover-view class="filter-text">公屋</cover-view>
      </cover-view>
      <cover-view class="housing-filter-btn {{housingTypeFilter.showSubsidized ? 'active' : ''}}" bindtap="toggleSubsidized">
        <cover-view class="filter-dot subsidized-dot"></cover-view>
        <cover-view class="filter-text">居屋</cover-view>
      </cover-view>
      <cover-view class="housing-filter-btn {{housingTypeFilter.showPrivate ? 'active' : ''}}" bindtap="togglePrivate">
        <cover-view class="filter-dot private-dot"></cover-view>
        <cover-view class="filter-text">私人</cover-view>
      </cover-view>
    </cover-view>
  </map>

  <!-- 小区信息卡片 -->
  <view class="estate-card" wx:if="{{showEstateCard}}" bindtap="closeEstateCard">
    <view class="estate-card-content" catchtap="preventClose">
      <view class="estate-card-header">
        <text class="estate-name">{{selectedEstate.estateName}}</text>
        <view class="close-btn" bindtap="closeEstateCard">×</view>
      </view>
      <view class="estate-info">
        <text class="estate-address">{{selectedEstate.address || '地址信息缺失'}}</text>
        <view class="estate-ratio" wx:if="{{selectedEstate.rentRatio}}">
          <text class="ratio-label">租售比：</text>
          <text class="ratio-value">{{selectedEstate.rentRatio}}%</text>
        </view>
      </view>
      <view class="estate-actions">
        <button class="detail-btn" bindtap="viewEstateDetail">查看详情</button>
      </view>
    </view>
  </view>

  <!-- 底部统计面板 -->
  <view class="stats-panel-container" wx:if="{{showStats}}">
    <stats-panel 
      estate-count="{{hasActiveFilter ? filteredCount : estateCount}}"
      avg-ratio="{{hasActiveFilter ? filteredAvgRatio : avgRatio}}"
      is-filtered="{{hasActiveFilter}}"
    ></stats-panel>
  </view>

  <!-- 色彩图例弹窗 -->
  <view class="legend-modal" wx:if="{{showLegend}}" bindtap="hideLegend">
    <view class="legend-content" catchtap="preventClose">
      <color-legend 
        min-value="{{minRatio}}"
        max-value="{{maxRatio}}"
        bind:close="hideLegend"
      ></color-legend>
    </view>
  </view>

  <!-- 筛选面板弹窗 -->
  <view class="filter-modal" wx:if="{{showFilterPanel}}" bindtap="hideFilterPanel">
    <view class="filter-panel" catchtap="preventClose">
      <!-- 面板头部 -->
      <view class="filter-header">
        <text class="filter-title">筛选条件</text>
        <view class="filter-actions">
          <text class="clear-btn" bindtap="clearAllFilters">清除全部</text>
          <view class="close-btn" bindtap="hideFilterPanel">×</view>
        </view>
      </view>
      
      <!-- 筛选内容 -->
      <scroll-view class="filter-body" scroll-y="true">
        <!-- 租售比区间筛选 -->
        <view class="filter-section">
          <view class="section-title">租售比区间</view>
          <view class="filter-options">
            <view 
              class="filter-option {{item.selected ? 'selected' : ''}}" 
              wx:for="{{rentRatioFilter.ranges}}" 
              wx:key="value"
              data-index="{{index}}"
              bindtap="toggleRentRatioRange"
            >
              <text class="option-text">{{item.label}}</text>
              <view class="check-icon" wx:if="{{item.selected}}">✓</view>
            </view>
          </view>
        </view>
        
        <!-- 建成年份筛选 -->
        <view class="filter-section">
          <view class="section-title">建成年份</view>
          <view class="filter-options">
            <view 
              class="filter-option {{item.selected ? 'selected' : ''}}" 
              wx:for="{{yearFilter.ranges}}" 
              wx:key="value"
              data-index="{{index}}"
              bindtap="toggleYearRange"
            >
              <text class="option-text">{{item.label}}</text>
              <view class="check-icon" wx:if="{{item.selected}}">✓</view>
            </view>
          </view>
        </view>
        
        <!-- 尺价筛选 -->
        <view class="filter-section">
          <view class="section-title">
            <text>目标尺价</text>
            <switch class="price-switch" checked="{{priceFilter.enabled}}" bindchange="togglePriceFilter" color="#667eea"/>
          </view>
          <view class="price-input-container" wx:if="{{priceFilter.enabled}}">
            <input 
              class="price-input" 
              type="digit" 
              placeholder="请输入目标尺价（港币/平方英尺）"
              value="{{priceFilter.targetPrice}}"
              bindinput="onPriceInput"
            />
            <text class="price-hint">将显示目标价±5%范围内的屋苑</text>
          </view>
        </view>
      </scroll-view>
      
      <!-- 面板底部 -->
      <view class="filter-footer">
        <view class="filter-result-info">
          <text class="result-count">{{filteredCount}}</text>
          <text class="result-text">个屋苑符合条件</text>
        </view>
        <button class="apply-btn" bindtap="applyAllFilters">应用筛选</button>
      </view>
    </view>
  </view>

  <!-- 空结果提示 -->
  <view class="empty-result" wx:if="{{!loading && hasActiveFilter && filteredCount === 0}}">
    <view class="empty-content">
      <text class="empty-icon">🔍</text>
      <text class="empty-text">没有找到符合条件的屋苑</text>
      <text class="empty-hint">请尝试调整筛选条件</text>
      <button class="reset-filter-btn" bindtap="clearAllFilters">清除筛选</button>
    </view>
  </view>

  <!-- 加载提示 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <view class="loading-content">
      <text>加载中...</text>
    </view>
  </view>

  <!-- 登录提示弹窗 -->
  <view class="login-modal" wx:if="{{showLoginModal}}">
    <view class="login-modal-mask" bindtap="closeLoginModal"></view>
    <view class="login-modal-content">
      <view class="login-modal-header">
        <text class="login-modal-title">欢迎访问</text>
        <view class="login-modal-close" bindtap="closeLoginModal">×</view>
      </view>
      <view class="login-modal-body">
        <image class="login-icon" src="/images/logo.png" mode="aspectFit"></image>
        <text class="login-text">登录后即可查看完整数据</text>
        <text class="login-subtext">我们将记录您的访问，以便提供更好的服务</text>
      </view>
      <view class="login-modal-footer">
        <button 
          class="login-btn" 
          open-type="getUserInfo" 
          bind:getuserinfo="handleLogin"
        >
          <text class="login-btn-text">微信一键登录</text>
        </button>
        <text class="guest-btn" bindtap="continueAsGuest">暂不登录，继续浏览</text>
      </view>
    </view>
  </view>
</view>
