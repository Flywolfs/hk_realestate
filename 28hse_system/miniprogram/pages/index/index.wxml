<!-- pages/index/index.wxml - 首页地图 -->
<view class="container">
  <!-- 地图容器 -->
  <map 
    id="estate-map"
    class="map"
    latitude="{{centerLat}}"
    longitude="{{centerLng}}"
    scale="{{scale}}"
    markers="{{markers}}"
    show-location="{{true}}"
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
    enable-3D="{{false}}"
    enable-overlooking="{{false}}"
    enable-zoom="{{true}}"
    enable-scroll="{{true}}"
    enable-rotate="{{false}}"
    show-compass="{{false}}"
  >
    <!-- 地图控件 -->
    <cover-view class="map-controls">
      <cover-view class="control-btn search-btn" bindtap="showSearch">
        <cover-view class="btn-text">搜索</cover-view>
      </cover-view>
      <cover-view class="control-btn legend-btn" bindtap="toggleLegend">
        <cover-view class="btn-text">图例</cover-view>
      </cover-view>
      <cover-view class="control-btn locate-btn" bindtap="relocate">
        <cover-view class="btn-text">重置</cover-view>
      </cover-view>
    </cover-view>
    
    <!-- 房屋类型筛选按钮 -->
    <cover-view class="housing-filter-container">
      <cover-view class="housing-filter-btn {{housingTypeFilter.showPublic ? 'active' : ''}}" bindtap="togglePublic">
        <cover-view class="filter-dot public-dot"></cover-view>
        <cover-view class="filter-text">公屋</cover-view>
      </cover-view>
      <cover-view class="housing-filter-btn {{housingTypeFilter.showSubsidized ? 'active' : ''}}" bindtap="toggleSubsidized">
        <cover-view class="filter-dot subsidized-dot"></cover-view>
        <cover-view class="filter-text">居屋</cover-view>
      </cover-view>
      <cover-view class="housing-filter-btn {{housingTypeFilter.showPrivate ? 'active' : ''}}" bindtap="togglePrivate">
        <cover-view class="filter-dot private-dot"></cover-view>
        <cover-view class="filter-text">私人</cover-view>
      </cover-view>
    </cover-view>
  </map>

  <!-- 小区信息卡片 -->
  <view class="estate-card" wx:if="{{showEstateCard}}" bindtap="closeEstateCard">
    <view class="estate-card-content" catchtap="preventClose">
      <view class="estate-card-header">
        <text class="estate-name">{{selectedEstate.estateName}}</text>
        <view class="close-btn" bindtap="closeEstateCard">×</view>
      </view>
      <view class="estate-info">
        <text class="estate-address">{{selectedEstate.address || '地址信息缺失'}}</text>
        <view class="estate-ratio" wx:if="{{selectedEstate.rentRatio}}">
          <text class="ratio-label">租售比：</text>
          <text class="ratio-value">{{selectedEstate.rentRatio}}%</text>
        </view>
      </view>
      <view class="estate-actions">
        <button class="detail-btn" bindtap="viewEstateDetail">查看详情</button>
      </view>
    </view>
  </view>

  <!-- 底部统计面板 -->
  <view class="stats-panel-container" wx:if="{{showStats}}">
    <stats-panel 
      estate-count="{{estateCount}}"
      avg-ratio="{{avgRatio}}"
    ></stats-panel>
  </view>

  <!-- 色彩图例弹窗 -->
  <view class="legend-modal" wx:if="{{showLegend}}" bindtap="hideLegend">
    <view class="legend-content" catchtap="preventClose">
      <color-legend 
        min-value="{{minRatio}}"
        max-value="{{maxRatio}}"
        bind:close="hideLegend"
      ></color-legend>
    </view>
  </view>

  <!-- 加载提示 -->
  <view class="loading-mask" wx:if="{{loading}}">
    <view class="loading-content">
      <text>加载中...</text>
    </view>
  </view>
</view>
