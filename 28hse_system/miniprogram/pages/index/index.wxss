/* pages/index/index.wxss - 首页样式 */

.container {
  width: 100%;
  height: 100vh;
  position: relative;
}

/* 地图 */
.map {
  width: 100%;
  height: 100%;
}

/* 地图控件 */
.map-controls {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.control-btn {
  width: 120rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.control-btn:active {
  background-color: rgba(255, 255, 255, 0.8);
  transform: scale(0.95);
}

.btn-text {
  color: #333;
  font-size: 24rpx;
  font-weight: 500;
}

/* 筛选按钮激活状态 */
.filter-btn.active {
  background-color: #667eea;
}

.filter-btn.active .btn-text {
  color: #fff;
}

/* 筛选红点提示 */
.filter-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #ff4757;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

.filter-btn {
  position: relative;
}

/* 房屋类型筛选按钮 */
.housing-filter-container {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.housing-filter-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.housing-filter-btn.active {
  background-color: #fff;
  border-color: #4CAF50;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.25);
}

.housing-filter-btn:active {
  transform: scale(0.95);
}

.filter-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.public-dot {
  background-color: #FF9800;
}

.subsidized-dot {
  background-color: #2196F3;
}

.private-dot {
  background-color: #4CAF50;
}

.filter-text {
  color: #333;
  font-size: 26rpx;
  font-weight: 500;
}

/* 小区信息卡片 */
.estate-card {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 9998;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.estate-card-content {
  width: 100%;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 60rpx;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.15);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.estate-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.estate-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  padding-right: 20rpx;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999;
  border-radius: 50%;
  background-color: #f0f0f0;
  transition: all 0.2s;
}

.close-btn:active {
  background-color: #e0e0e0;
  transform: scale(0.9);
}

.estate-info {
  margin-bottom: 32rpx;
}

.estate-address {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.estate-ratio {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  margin-top: 16rpx;
}

.ratio-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 8rpx;
}

.ratio-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.estate-actions {
  display: flex;
  gap: 20rpx;
}

.detail-btn {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(102, 126, 234, 0.3);
  transition: all 0.2s;
}

.detail-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 底部统计面板 */
.stats-panel-container {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  right: 20rpx;
  background-color: transparent;
  padding: 0;
  z-index: 100;
}

/* 图例弹窗 */
.legend-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.legend-content {
  width: 85%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

/* 加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-content text {
  color: #666;
  font-size: 28rpx;
}

/* ========== 筛选面板样式 ========== */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease;
}

.filter-panel {
  width: 100%;
  max-height: 80vh;
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
}

/* 面板头部 */
.filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.filter-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.clear-btn {
  font-size: 28rpx;
  color: #667eea;
  padding: 8rpx 16rpx;
}

.filter-header .close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
  background-color: #f5f5f5;
  border-radius: 50%;
}

/* 筛选内容区 */
.filter-body {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 60vh;
}

.filter-section {
  margin-bottom: 40rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 筛选选项 */
.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.filter-option.selected {
  background-color: rgba(102, 126, 234, 0.1);
  border-color: #667eea;
}

.option-text {
  font-size: 26rpx;
  color: #666;
}

.filter-option.selected .option-text {
  color: #667eea;
  font-weight: 500;
}

.check-icon {
  font-size: 24rpx;
  color: #667eea;
  font-weight: bold;
}

/* 尺价输入 */
.price-switch {
  transform: scale(0.8);
}

.price-input-container {
  margin-top: 16rpx;
}

.price-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.price-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* 面板底部 */
.filter-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 48rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fff;
}

.filter-result-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.result-count {
  font-size: 40rpx;
  font-weight: 700;
  color: #667eea;
}

.result-text {
  font-size: 26rpx;
  color: #666;
}

.apply-btn {
  width: 240rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(102, 126, 234, 0.3);
}

.apply-btn::after {
  border: none;
}

.apply-btn:active {
  transform: scale(0.98);
}

/* ========== 空结果提示 ========== */
.empty-result {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 100;
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

.reset-filter-btn {
  margin-top: 24rpx;
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.reset-filter-btn::after {
  border: none;
}

/* ========== 登录弹窗 ========== */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.login-modal-content {
  position: relative;
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
}

.login-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.login-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.login-modal-close {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

.login-modal-body {
  padding: 40rpx;
  text-align: center;
}

.login-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
}

.login-text {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 15rpx;
}

.login-subtext {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.login-modal-footer {
  padding: 30rpx 40rpx 40rpx;
}

.login-btn {
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  padding: 20rpx 0;
  border-radius: 10rpx;
  border: none;
  margin-bottom: 20rpx;
}

.login-btn::after {
  border: none;
}

.login-btn-text {
  font-weight: 500;
}

.guest-btn {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  padding: 15rpx 0;
}
